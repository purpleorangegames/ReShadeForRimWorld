+// Shaders are written on Windows: includes may use backslashes and a different case than the file on disk.
+// This turns such a path into the real one when it exists, so they also work on case-sensitive file systems.
+static bool exists_windows_style(std::filesystem::path &path)
+{
+	std::error_code ec;
+	if (std::filesystem::exists(path, ec))
+		return true;
+
+	std::string text = path.u8string();
+	std::replace(text.begin(), text.end(), '\\', '/');
+	std::filesystem::path normalized = std::filesystem::u8path(text).lexically_normal();
+	if (std::filesystem::exists(normalized, ec))
+		return path = normalized, true;
+
+	std::filesystem::path resolved = normalized.root_path();
+	for (const std::filesystem::path &part : normalized.relative_path())
+	{
+		std::filesystem::path next = resolved / part;
+		if (!std::filesystem::exists(next, ec))
+		{
+			const std::string wanted = part.u8string();
+			bool found = false;
+			for (const std::filesystem::directory_entry &entry : std::filesystem::directory_iterator(resolved.empty() ? std::filesystem::path(".") : resolved, ec))
+			{
+				const std::string name = entry.path().filename().u8string();
+				if (name.size() == wanted.size() && std::equal(name.begin(), name.end(), wanted.begin(), [](char a, char b) { return std::tolower(static_cast<unsigned char>(a)) == std::tolower(static_cast<unsigned char>(b)); }))
+				{
+					next = entry.path();
+					found = true;
+					break;
+				}
+			}
+			if (!found)
+				return false;
+		}
+		resolved = next;
+	}
+	return path = resolved, true;
+}
